      "isDeleted": false,
      "boundElements": [],
      "updated": 1793079918416,
      "link": null,
      "locked": false,
      "text": "Why it runs on a GPU",
      "originalText": "Why it runs on a GPU",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 17,
      "index": "b0M",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "e85",
      "type": "text",
      "x": 679.5,
      "y": 999.25,
      "width": 351,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 49597690,
      "version": 2,
      "versionNonce": 1701505913,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793079918416,
      "link": null,
      "locked": false,
      "text": "To pass its memory on, Telepathy has to reach\ninside the AI model. Online AI services only\ntake text in and give text out, so Telepathy\nruns on a GPU we control.\n\nWe also measured the usual flow at 2 to 8\nagents on Nebius Token Factory, with NVIDIA\nNemotron 3 Super.",
      "originalText": "To pass its memory on, Telepathy has to reach\ninside the AI model. Online AI services only\ntake text in and give text out, so Telepathy\nruns on a GPU we control.\n\nWe also measured the usual flow at 2 to 8\nagents on Nebius Token Factory, with NVIDIA\nNemotron 3 Super.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 13,
      "index": "b0N",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
