    },
    {
      "id": "e74",
      "type": "text",
      "x": 977.66943359375,
      "y": 731.75,
      "width": 176.6611328125,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 151001551,
      "version": 3,
      "versionNonce": 1394520217,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793079960733,
      "link": null,
      "locked": false,
      "text": "The next agent's job prompt\nis added on top of the same\nKV cache. It can attend to\neverything the earlier agents\nread and thought, without\nrereading any text.",
      "originalText": "The next agent's job prompt\nis added on top of the same\nKV cache. It can attend to\neverything the earlier agents\nread and thought, without\nrereading any text.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 12,
      "index": "b0C",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
