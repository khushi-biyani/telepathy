    {
      "id": "e70",
      "type": "text",
      "x": 689.70751953125,
      "y": 731.75,
      "width": 180.5849609375,
      "height": 122.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 730259659,
      "version": 3,
      "versionNonce": 2071133719,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793079954383,
      "link": null,
      "locked": false,
      "text": "Instead of saying its thought\nas a word, the model keeps\nthe thought and thinks on top\nof it, quietly, a few times\nover. Each silent thought\nadds to the KV cache; no\nwords come out.",
      "originalText": "Instead of saying its thought\nas a word, the model keeps\nthe thought and thinks on top\nof it, quietly, a few times\nover. Each silent thought\nadds to the KV cache; no\nwords come out.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 12,
      "index": "b08",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
