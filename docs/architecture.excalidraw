      "isDeleted": false,
      "boundElements": [],
      "updated": 1793079918415,
      "link": null,
      "locked": false,
      "text": "An AI model builds a working memory (the KV cache) as it thinks. Telepathy hands it straight to the next agent, like passing on thoughts instead of a letter.",
      "originalText": "An AI model builds a working memory (the KV cache) as it thinks. Telepathy hands it straight to the next agent, like passing on thoughts instead of a letter.",
