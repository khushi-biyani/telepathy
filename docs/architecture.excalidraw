      "boundElements": [],
      "updated": 1793079918416,
      "link": null,
      "locked": false,
      "text": "4   WHAT WE MEASURED",
      "originalText": "4   WHAT WE MEASURED",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 17,
      "index": "b0J",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "e82",
      "type": "text",
      "x": 90.39999999999998,
      "y": 999.25,
      "width": 499.20000000000005,
      "height": 131.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 309489966,
      "version": 2,
      "versionNonce": 1424150103,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793079918416,
      "link": null,
      "locked": false,
      "text": "We asked the same questions three ways: one agent alone, a usual\nmulti-agent system, and Telepathy, on the same model (NVIDIA\nNemotron Nano 4B) and the same GPU (NVIDIA Tesla T4).\n\nAcross maths, coding, a medical exam and web research, Telepathy\nwas 2.9× to 40× faster than the usual multi-agent system, wrote\n60% to 98% fewer tokens, and was just as accurate or more.",
      "originalText": "We asked the same questions three ways: one agent alone, a usual\nmulti-agent system, and Telepathy, on the same model (NVIDIA\nNemotron Nano 4B) and the same GPU (NVIDIA Tesla T4).\n\nAcross maths, coding, a medical exam and web research, Telepathy\nwas 2.9× to 40× faster than the usual multi-agent system, wrote\n60% to 98% fewer tokens, and was just as accurate or more.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 13,
      "index": "b0K",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "e83",
      "type": "rectangle",
      "x": 650,
      "y": 955.5,
      "width": 410,
      "height": 213.75,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "#f1f3f5",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
