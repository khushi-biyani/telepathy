      "link": null,
      "locked": false,
      "index": "b0L",
      "created": null
    },
    {
      "id": "e84",
      "type": "text",
      "x": 756.2,
      "y": 969.5,
      "width": 197.6,
      "height": 23.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
