      "created": null
    },
    {
      "id": "e81",
      "type": "text",
      "x": 241.2,
      "y": 969.5,
      "width": 197.6,
      "height": 23.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
